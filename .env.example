# Copy to .env.production on the server (or .env.local on your machine)
# and fill in the values. .env* files are gitignored except this one.
#
# Both values are written into the site when it is built (`npm run build`),
# so after changing them run a full deploy (bash scripts/deploy.sh), not just
# a PM2 restart. Setting them in ecosystem.config.cjs has no effect.

# The live site's address, used for share previews, the sitemap and robots.txt.
# No trailing slash. Use the exact final domain (with or without www).
# If empty, the site uses https://aripratech.com.
NEXT_PUBLIC_SITE_URL=https://aripratech.com

# Google Tag Manager container. Leave empty to keep Tag Manager off
# (local machines and the test server). Set to GTM-KF2R8CT only on the live
# server, on the day of the domain switch.
NEXT_PUBLIC_GTM_ID=
