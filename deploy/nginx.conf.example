# Nginx reverse proxy for the Next.js app running under PM2 on 127.0.0.1:3000.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/aripra
#   sudo sed -i 's/example.com/yourdomain.com/g' /etc/nginx/sites-available/aripra
#   sudo ln -s /etc/nginx/sites-available/aripra /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d example.com -d www.example.com   # adds HTTPS

upstream aripra_next {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    client_max_body_size 10m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed build assets never change: cache for a year.
    location /_next/static/ {
        proxy_pass http://aripra_next;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://aripra_next;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
